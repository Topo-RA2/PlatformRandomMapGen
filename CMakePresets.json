{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64",
      "displayName": "windows-msvc-x64",
      "generator": "Ninja",
      "architecture": {"value": "x64", "strategy": "external"},
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLATFORMRANDOMMAPGEN_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-msvc-x64-tests",
      "inherits": "windows-msvc-x64",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "PLATFORMRANDOMMAPGEN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "linux-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLATFORMRANDOMMAPGEN_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-tests",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "PLATFORMRANDOMMAPGEN_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-x64",
      "configurePreset": "windows-msvc-x64",
      "targets": [
        "rmg"
      ]
    },
    {
      "name": "windows-msvc-x64-tests",
      "configurePreset": "windows-msvc-x64-tests",
      "targets": [
        "rmg",
        "rmg_tests"
      ]
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "targets": [
        "rmg"
      ]
    },
    {
      "name": "linux-tests",
      "configurePreset": "linux-tests",
      "targets": [
        "rmg",
        "rmg_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-x64-tests",
      "configurePreset": "windows-msvc-x64-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-tests",
      "configurePreset": "linux-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error"
      }
    }
  ]
}
